{
  "name": "a-window",
  "productName": "A Window",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A calm day planner set inside a live window that follows the real weather, time of day and season.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "artifact": "vite build && node scripts/artifact.mjs",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "app.awindow.planner",
    "productName": "A Window",
    "files": [
      "electron/main.cjs",
      "dist/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "trustedDependencies": [
    "electron"
  ]
}
