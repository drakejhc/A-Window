{
  "name": "a-window",
  "productName": "A Window",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A calm day planner set inside a live window that follows the real weather, time of day and season.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "artifact": "vite build && node scripts/artifact.mjs",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "jsdom": "20.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "app.awindow.planner",
    "productName": "A Window",
    "artifactName": "A-Window-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**",
      "dist/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "A Window shows the song playing in Spotify or Music, and lets you pause or skip it."
      }
    },
    "dmg": {
      "title": "A Window"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "A Window"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "trustedDependencies": [
    "electron"
  ],
  "author": {
    "name": "Drake Chen"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drakejhc/a-window.git"
  },
  "desktopName": "a-window.desktop"
}
